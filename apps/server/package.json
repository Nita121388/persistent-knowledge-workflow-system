{
  "name": "@pkws/server",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx/esm --watch src/index.ts",
    "start": "node --experimental-sqlite dist/index.js",
    "build": "tsc",
    "db:generate": "drizzle-kit generate --config=../storage/drizzle.config.ts",
    "db:migrate": "tsx src/db-migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/websocket": "^11.2.0",
    "@pkws/agent-runtime": "workspace:*",
    "@pkws/ai": "workspace:*",
    "@pkws/shared": "workspace:*",
    "@pkws/storage": "workspace:*",
    "@pkws/vault": "workspace:*",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "p-queue": "^8.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
